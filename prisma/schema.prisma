generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id          Int     @id @default(autoincrement())
  username    String? @unique @db.VarChar(100)
  password    String? @db.VarChar(255)
  email       String? @unique
  googleEmail String? @unique @map("google_email")

  name String @map("full_name") @db.VarChar(200)
  role Role   @default(dosen)

  unitId Int?  @map("unit_id")
  unit   Unit? @relation(fields: [unitId], references: [id])

  phoneNumber     String?  @unique @db.VarChar(30)
  identifier      String?  @db.VarChar(255)
  avatarUrl       String?
  accessibleMenus String[] @default([]) @map("accessible_menus")

  conversations Conversation[]

  // === Relasi ke Halo Dekan === 
  reportedTickets ComplainmentTicket[] @relation("ReportedTickets")
  assignedTickets ComplainmentTicket[] @relation("AssignedTickets")
  ticketComments  TicketComment[]      @relation("UserComments")
  histories       TicketHistory[]      @relation("UserHistories")

  supervisorId Int?    @map("supervisor_id")
  supervisor   Users?  @relation("UserHierarchy", fields: [supervisorId], references: [id])
  subordinates Users[] @relation("UserHierarchy")

  contractInputs ContractAssignment[] @relation("UserInputs")

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  disposisiSurats DisposisiSurat[] @relation("PemberiDisposisi")

  @@map("users")
}

model Conversation {
  id                  Int       @id @default(autoincrement())
  userId              Int       @map("user_id")
  category            Category?
  last_bot_message_id Int?      @map("last_bot_message_id")
  step                Step
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  user                Users     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "conversations_ibfk_1")
  messages            Message[]

  @@index([userId], map: "user_id")
  @@map("conversations")
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int          @map("conversation_id")
  sender         Sender
  message_text   String       @map("message_text") @db.Text
  need_human     Boolean?     @default(false) @map("need_human")
  feedback       Feedback?
  createdAt      DateTime?    @default(now()) @map("created_at") @db.Timestamp(0)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "messages_ibfk_1")
  unresolved     Unresolved[]

  @@index([conversationId], map: "conversation_id")
  @@map("messages")
}

model Unresolved {
  id         Int       @id @default(autoincrement())
  messageId  Int       @map("message_id")
  status     Status?   @default(open)
  assignedTo String?   @map("assigned_to") @db.VarChar(100)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime  @updatedAt @map("updated_at")
  message    Message   @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "unresolved_ibfk_1")

  @@index([messageId], map: "message_id")
  @@map("unresolved")
}

model Schedule {
  id               Int            @id @default(autoincrement())
  eventTitle       String         @map("event_title")
  eventDescription String         @map("event_description") @db.Text
  eventTime        DateTime       @map("event_time")
  reminderTime     DateTime       @map("reminder_time")
  status           ScheduleStatus @default(pending)
  createdBy        String         @map("created_by")
  createdAt        DateTime       @default(now()) @map("created_at")

  // Relasi: Satu Jadwal bisa punya banyak Penerima
  recipients ScheduleRecipient[]

  @@map("schedules")
}

model ScheduleRecipient {
  id         Int      @id @default(autoincrement())
  scheduleId Int      @map("schedule_id")
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  contactId Int?      @map("contact_id")
  contact   Contacts? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("schedule_recipients")
}

model Contacts {
  id          Int     @id @default(autoincrement())
  name        String
  title       String
  phoneNumber String  @unique @map("phone_number")
  notes       String? @map("notes") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  schedules ScheduleRecipient[]

  @@map("contacts")
}

// Partnership Monitoring ---
model PartnershipDocument {
  id          Int      @id @default(autoincrement())
  yearIssued  Int      @map("year_issued")
  docType     DocType? @map("doc_type")
  partnerName String   @map("partner_name")
  scope       Scope?

  picExternal      String? @map("pic_external")
  picExternalPhone String? @map("pic_external_phone")
  picInternal      String? @map("pic_internal")

  docNumberInternal String? @unique @map("doc_number_internal")
  docNumberExternal String? @unique @map("doc_number_external")

  partnershipType PartnershipType?      @map("partnership_type")
  activities      PartnershipActivity[]

  dateCreated DateTime? @map("date_created")
  signingType String?   @map("signing_type")
  dateSigned  DateTime? @map("date_signed")
  validUntil  DateTime? @map("valid_until")
  duration    String?   @map("duration")

  // --- APPROVAL WORKFLOW (Baju Surat) ---
  approvalWadek2      ApprovalStatus? @map("approval_wadek2")
  approvalWadek1      ApprovalStatus? @map("approval_wadek1")
  approvalKabagKST    ApprovalStatus? @map("approval_kabag_kst")
  approvalDirSPIO     ApprovalStatus? @map("approval_dir_spio")
  approvalDirMIK      ApprovalStatus? @map("approval_dir_mik")
  approvalKaurLegal   ApprovalStatus? @map("approval_kaur_legal")
  approvalKabagSekpim ApprovalStatus? @map("approval_kabag_sekpim")
  approvalDirSPS      ApprovalStatus? @map("approval_dir_sps")
  approvalDekan       ApprovalStatus? @map("approval_dekan")
  approvalWarek1      ApprovalStatus? @map("approval_warek1")
  approvalRektor      ApprovalStatus? @map("approval_rektor")

  // --- Arsip & Lainnya ---
  docLink String? @map("doc_link")
  notes   String? @db.Text

  hasHardcopy Boolean @default(false) @map("has_hardcopy")
  hasSoftcopy Boolean @default(false) @map("has_softcopy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("partnership_documents")
}

model PartnershipActivity {
  id           Int              @id @default(autoincrement())
  category     PartnershipType?
  name         String?
  status       ActivityStatus?  @default(BelumTerlaksana)
  notes        String?          @db.Text
  evidenceLink String?          @map("evidence_link")

  // Relasi ke Dokumen
  documentId Int                 @map("document_id")
  document   PartnershipDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("partnership_activities")
}

// ==== Contract Management ====
model ContractManagement {
  id                         Int                         @id @default(autoincrement())
  order                      Int?                        @default(0)
  ContractManagementCategory ContractManagementCategory?
  subCategory                String?                     @map("sub_category")
  responsibility             String
  definition                 String?                     @db.Text
  objective                  String?                     @db.Text
  indicatorCalc              String?                     @db.Text

  unitOfMeasurement String? @map("unit_of_measurement")
  year              String?

  targetTw1 String? @map("target_tw1")
  targetTw2 String? @map("target_tw2")
  targetTw3 String? @map("target_tw3")
  targetTw4 String? @map("target_tw4")

  weightTw1 Float? @map("weight_tw1")
  weightTw2 Float? @map("weight_tw2")
  weightTw3 Float? @map("weight_tw3")
  weightTw4 Float? @map("weight_tw4")

  realizationTw1 Float? @map("realization_tw1")
  realizationTw2 Float? @map("realization_tw2")
  realizationTw3 Float? @map("realization_tw3")
  realizationTw4 Float? @map("realization_tw4")

  achievementTw1 Float? @map("achievement_tw1")
  achievementTw2 Float? @map("achievement_tw2")
  achievementTw3 Float? @map("achievement_tw3")
  achievementTw4 Float? @map("achievement_tw4")

  persRealTw1 Float? @map("pers_real_tw1")
  persRealTw2 Float? @map("pers_real_tw2")
  persRealTw3 Float? @map("pers_real_tw3")
  persRealTw4 Float? @map("pers_real_tw4")

  valueTw1 Float? @map("value_tw1")
  valueTw2 Float? @map("value_tw2")
  valueTw3 Float? @map("value_tw3")
  valueTw4 Float? @map("value_tw4")

  minTw1 Float? @map("min_tw1")
  minTw2 Float? @map("min_tw2")
  minTw3 Float? @map("min_tw3")
  minTw4 Float? @map("min_tw4")

  maxTw1 Float? @map("max_tw1")
  maxTw2 Float? @map("max_tw2")
  maxTw3 Float? @map("max_tw3")
  maxTw4 Float? @map("max_tw4")

  strategy String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignments ContractAssignment[]

  @@map("contract_management")
}

model ContractAssignment {
  id         Int @id @default(autoincrement())
  contractId Int @map("contract_id")
  unitId     Int @map("unit_id")

  realizationTw1 Float? @map("realization_tw1")
  realizationTw2 Float? @map("realization_tw2")
  realizationTw3 Float? @map("realization_tw3")
  realizationTw4 Float? @map("realization_tw4")

  achievementTw1 Float? @map("achievement_tw1")
  achievementTw2 Float? @map("achievement_tw2")
  achievementTw3 Float? @map("achievement_tw3")
  achievementTw4 Float? @map("achievement_tw4")

  persRealTw1 Float? @map("pers_real_tw1")
  persRealTw2 Float? @map("pers_real_tw2")
  persRealTw3 Float? @map("pers_real_tw3")
  persRealTw4 Float? @map("pers_real_tw4")

  valueTw1 Float? @map("value_tw1")
  valueTw2 Float? @map("value_tw2")
  valueTw3 Float? @map("value_tw3")
  valueTw4 Float? @map("value_tw4")

  inputNote   String? @map("input_note") @db.Text
  monitorNote String? @map("monitor_note") @db.Text

  contract ContractManagement @relation(fields: [contractId], references: [id], onDelete: Cascade)
  unit     Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId Int?   @map("user_id")
  user   Users? @relation("UserInputs", fields: [userId], references: [id])

  // Constraint: 1 KPI tidak boleh di-assign dua kali ke Unit yang sama
  @@unique([contractId, unitId])
  @@map("contract_assignments")
}

// --- ActivityMonitoring ---
model ActivityMonitoring {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?
  date         DateTime  @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  startTime    DateTime
  endTime      DateTime
  participants Int       @default(0)

  unit           UnitOption
  otherUnit      String?
  room           RoomOption       @default(AulaFEB)
  locationDetail String?          @map("location_detail")
  officials      OfficialOption[]

  status ActivityMonitoringStatus @default(Normal)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("activity_monitoring")
}

// --- Management Report ---
model ManagementReport {
  id Int @id @default(autoincrement())

  indicator    String  @map("indicator")
  evidenceLink String? @map("evidence_link") @db.Text
  year         Int

  tw1 Boolean @default(false) @map("tw_1")
  tw2 Boolean @default(false) @map("tw_2")
  tw3 Boolean @default(false) @map("tw_3")
  tw4 Boolean @default(false) @map("tw_4")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([indicator, year])
  @@index([year])
  @@index([indicator])
  @@map("management_reports")
}

model EmployeeTPA {
  id               Int    @id @default(autoincrement())
  name             String @map("name")
  nip              String @unique
  workUnit         String @map("work_unit")
  employmentStatus String @map("employment_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employee_tpa")
}

model Lecturer {
  id            Int     @id @default(autoincrement())
  nip           String  @unique
  nuptk         String?
  frontTitle    String? @map("front_title")
  name          String
  backTitle     String? @map("back_title")
  prodi         String
  lecturerCode  String? @unique @map("lecturer_code")
  education     String?
  jobFunctional String? @map("job_functional")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("lecturers")
}

model Meeting {
  id             Int        @id @default(autoincrement())
  title          String     @map("title")
  date           DateTime   @db.Date
  startTime      DateTime   @map("start_time")
  endTime        DateTime   @map("end_time")
  leader         String
  notetaker      String
  room           RoomOption
  locationDetail String?    @map("location_detail")

  participants String[] @map("participants")

  // Relasi ke Anak
  agendas MeetingAgenda[]
  status  MeetingStatus   @default(Terjadwal)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("meetings")
}

model MeetingAgenda {
  id         Int     @id @default(autoincrement())
  title      String
  discussion String? @db.Text
  decision   String? @db.Text

  // Relasi ke Induk
  meetingId   Int                 @map("meeting_id")
  meeting     Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  actionItems MeetingActionItem[]

  @@map("meeting_agendas")
}

model MeetingActionItem {
  id       Int      @id @default(autoincrement())
  task     String   @db.Text
  pic      String
  deadline DateTime @db.Date
  notes    String?  @db.Text

  status MeetingActionStatus @default(Open)

  agendaId Int           @map("agenda_id")
  agenda   MeetingAgenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)

  @@map("meeting_action_items")
}

model ComplainmentTicket {
  id         Int    @id @default(autoincrement())
  ticketCode String @unique

  userId       Int
  user         Users   @relation("ReportedTickets", fields: [userId], references: [id], onDelete: Cascade)
  name         String?
  assignedToId Int?
  assignedTo   Users?  @relation("AssignedTickets", fields: [assignedToId], references: [id])

  category      ComplainmentCategory
  description   String               @db.Text
  attachmentUrl String[]             @map("attachment_url")

  resolutionProofUrls String[] @map("resolution_proof_urls")
  resolutionNote      String?  @map("resolution_note") @db.Text

  status     ComplainmentTicketStatus @default(Submitted)
  actionNote String?                  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketComments TicketComment[] @relation("TicketComments")
  histories      TicketHistory[] @relation("TicketHistories")

  @@map("complainment_ticket")
}

model TicketComment {
  id Int @id @default(autoincrement())

  // Relasi ke Tiket mana komentar ini berada
  ticketId Int
  ticket   ComplainmentTicket @relation("TicketComments", fields: [ticketId], references: [id], onDelete: Cascade)

  // Siapa yang ngetik pesan ini? (Bisa Admin, Dekan, Unit, atau Mahasiswa)
  senderId Int
  sender   Users @relation("UserComments", fields: [senderId], references: [id], onDelete: Cascade)

  message        String   @db.Text
  attachmentUrls String[] @map("attachment_urls")

  createdAt DateTime @default(now())

  @@map("ticket_comment")
}

model TicketHistory {
  id Int @id @default(autoincrement())

  ticketId Int
  ticket   ComplainmentTicket @relation("TicketHistories", fields: [ticketId], references: [id], onDelete: Cascade)

  // Siapa yang melakukan aksi ini? (Bisa sistem, bisa User)
  actorId Int
  actor   Users @relation("UserHistories", fields: [actorId], references: [id])

  // Aksi apa yang dilakukan? (Misal: "SUBMITTED", "ASSIGNED", "COMMENTED")
  actionType String

  // (Bisa actionNote atau resolutionNote)
  message String? @db.Text

  createdAt DateTime @default(now())

  @@map("ticket_history")
}

model Unit {
  id       Int          @id @default(autoincrement())
  name     String       @db.VarChar(100)
  category UnitCategory

  users           Users[] // Relasi ke User yang ada di unit ini
  assignments     ContractAssignment[] // Relasi ke KPI yang diberikan ke unit ini
  disposisiSurats DisposisiSurat[]     @relation("PenerimaDisposisi")

  @@map("units")
}

// ==== RTM ====
model RtmMeeting {
  id      Int     @id @default(autoincrement())
  rtmCode String? @map("rtm_code")

  // === Section 1: Input Kegiatan Rapat ===
  sotk         String?
  pic          String?
  meetingDate  DateTime? @map("meeting_date")
  name         String
  participants String?   @db.Text

  // === Section 2: Materi Rapat ===
  materials String[]

  // === Section 3: Header Risalah (Kop) ===
  documentDate DateTime? @map("document_date") // Tanggal di tabel Kop
  location     String? // Tempat
  agenda       String?   @db.Text // Agenda

  // === Section 4: Signatures (Tanda Tangan) ===
  preparedByName     String? @map("prepared_by_name")
  preparedByPosition String? @map("prepared_by_position")

  reviewedByName     String? @map("reviewed_by_name")
  reviewedByPosition String? @map("reviewed_by_position")

  approvedByName     String? @map("approved_by_name")
  approvedByPosition String? @map("approved_by_position")

  signatureLocation String?   @map("signature_location")
  signatureDate     DateTime? @map("signature_date")

  // === Relasi ke Baris Tabel Pembahasan ===
  discussions RtmDiscussion[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rtm_meetings")
}

// ==========================================
// 2. Tabel Anak untuk Baris Pembahasan (Tabel Gambar 3)
// ==========================================
model RtmDiscussion {
  id           Int @id @default(autoincrement())
  rtmMeetingId Int @map("rtm_meeting_id")

  // Field ini dibuat opsional (?) karena user mungkin tambah baris kosong dulu baru diisi bertahap
  topic      String? @db.Text // Topik
  problem    String? @db.Text // Pembahasan / Permasalahan
  actionPlan String? @db.Text // Rencana Tindakan / Perbaikan
  outcome    String? @db.Text // Luaran / Outcomes
  pic        String? // PIC
  target     String? // Target (Pake string biar fleksibel misal "Akhir Q3" atau "30 Mei")
  status     String? // Status

  // Relasi balik ke tabel induk (onDelete Cascade wajib biar gak orphaned data)
  meeting RtmMeeting @relation(fields: [rtmMeetingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rtm_discussions")
}

model OtpRequest {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  otp       String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_requests")
}

// ==========================================
// SCHEMA SURAT MENYURAT
// ==========================================
// ==========================================
// TAB 1: SURAT MASUK
// ==========================================
model SuratMasuk {
  id               Int      @id @default(autoincrement())
  nomorSuratAsal   String   @map("nomor_surat_asal")
  instansiPengirim String   @map("instansi_pengirim")
  tanggalSurat     DateTime @map("tanggal_surat")
  tanggalDiterima  DateTime @map("tanggal_diterima")

  kerahasiaan KlasifikasiSurat @default(Normal)
  retensi     RetensiSurat     @default(SatuTahun)

  perihal   String
  ringkasan String  @db.Text
  linkPdf   String? @map("link_pdf")

  status String @default("Diterima")

  disposisi DisposisiSurat[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("surat_masuk")
}

// ==========================================
// SURAT KELUAR
// ==========================================
model SuratKeluar {
  id             Int              @id @default(autoincrement())
  nomorSurat     String?          @unique @map("nomor_surat")
  jenisSurat     JenisSurat       @map("jenis_surat")
  kerahasiaan    KlasifikasiSurat @default(Normal)
  tujuanPenerima String           @map("tujuan_penerima")
  perihal        String
  tanggalSurat   DateTime?        @map("tanggal_surat")

  // --- Field Detail untuk Canvas PDF (Tab 3) ---
  salamPembuka         String? @map("salam_pembuka")
  paragrafPembuka      String? @map("paragraf_pembuka") @db.Text
  isiUtama             String  @map("isi_utama") @db.Text
  paragrafPenutup      String? @map("paragraf_penutup") @db.Text
  namaPenandatangan    String? @map("nama_penandatangan")
  jabatanPenandatangan String? @map("jabatan_penandatangan")

  // --- Control & Tracking (Tab 2) ---
  status StatusSuratKeluar @default(Draft)

  // Relasi ke Users (Dekan/Wadek yang klik "Setujui")
  penyetujuId Int? @map("penyetuju_id")
  // penyetuju         Users?               @relation("PenyetujuSurat", fields: [penyetujuId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("surat_keluar")
}

// ======================
// DISPOSISI SURAT
// ======================
model DisposisiSurat {
  id           Int @id @default(autoincrement())
  suratMasukId Int @map("surat_masuk_id")

  // Relasi ke tabel Users (Pimpinan yang mendisposisi)
  pemberiId Int @map("pemberi_id")

  // Relasi ke tabel Unit (Karena API tujuan pakai list Unit jabatan)
  penerimaUnitId Int @map("penerima_unit_id")

  instruksi  InstruksiDisposisi
  batasWaktu DateTime?          @map("batas_waktu")
  catatan    String?            @db.Text
  status     StatusDisposisi    @default(BelumDiproses)

  // Definisi Relasi
  suratMasuk   SuratMasuk @relation(fields: [suratMasukId], references: [id], onDelete: Cascade)
  pemberi      Users      @relation("PemberiDisposisi", fields: [pemberiId], references: [id])
  penerimaUnit Unit       @relation("PenerimaDisposisi", fields: [penerimaUnitId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("disposisi_surat")
}

enum Category {
  Sidang
  Keuangan
  Wisuda
  Sekretariat
  Wadek1
  Wadek2
  ProdiS1
  ProdiS2
}

enum Step {
  select_role
  ask_lecturer_name
  lecturer_select_unit
  ask_student_nim
  ask_student_name
  menu
  chat
  awaiting_feedback
}

enum Sender {
  user
  bot
  admin
}

enum Feedback {
  ONE   @map("1")
  TWO   @map("2")
  THREE @map("3")
}

enum Status {
  open
  in_progress
  resolved
}

enum ScheduleStatus {
  draft
  pending
  sent
  cancelled
}

// --- Partnership Monitoring ---

enum DocType {
  MoA
  MoU
  IA
}

enum Scope {
  national
  international
}

enum PartnershipType {
  Akademik
  Penelitian
  Abdimas
}

// enum ActivityType {
//   // --- Sub Akademik ---
//   JointDegree
//   DoubleDegree
//   JointClass
//   StudentExchange
//   VisitingProfessor

//   // --- Sub Penelitian ---
//   JointResearch
//   JointPublication

//   // --- Sub Abdimas ---
//   JointCommunityService
//   SocialProject

//   // --- Umum ---
//   General
// }

enum ActivityStatus {
  Terlaksana
  BelumTerlaksana
}

enum ApprovalStatus {
  Approved
